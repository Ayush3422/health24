# The database, the cache and the bucket (sp7-plan.md, T16).
#
# Everything here holds patient data, and every line below is either about
# keeping it in India, keeping it encrypted, keeping it reachable only from the
# tasks, or being able to get it back.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------

resource "aws_db_subnet_group" "this" {
  name       = local.name
  subnet_ids = aws_subnet.data[*].id

  tags = { Name = local.name }
}

resource "aws_kms_key" "database" {
  description             = "${local.name} database encryption"
  enable_key_rotation     = true
  deletion_window_in_days = 30
}

resource "aws_kms_alias" "database" {
  name          = "alias/${local.name}-database"
  target_key_id = aws_kms_key.database.key_id
}

resource "aws_db_parameter_group" "this" {
  name   = local.name
  family = "postgres16"

  # Connections are refused rather than downgraded: an unencrypted connection
  # to a database of patient records is not something to allow quietly.
  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  # Slow queries, so the timeline's performance budget (SP3) can be watched in
  # production rather than only in a test.
  parameter {
    name  = "log_min_duration_statement"
    value = "500"
  }

  # Statements are logged without their parameters, which is where a patient's
  # name would otherwise end up in a log nobody scrubs (DF4).
  parameter {
    name  = "log_statement"
    value = "ddl"
  }
}

resource "aws_db_instance" "this" {
  identifier = local.name

  engine         = "postgres"
  engine_version = "16"
  instance_class = var.database.instance_class

  db_name  = "health24"
  username = "health24"
  # Generated by AWS and kept in Secrets Manager, so no password is ever in
  # this repository, in state as plaintext, or in a variable somebody exports.
  manage_master_user_password   = true
  master_user_secret_kms_key_id = aws_kms_key.database.key_id

  allocated_storage     = var.database.allocated_storage_gb
  max_allocated_storage = var.database.max_allocated_storage_gb
  storage_type          = "gp3"
  storage_encrypted     = true
  kms_key_id            = aws_kms_key.database.arn

  multi_az               = var.database.multi_az
  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.database.id]
  publicly_accessible    = false
  parameter_group_name   = aws_db_parameter_group.this.name

  # Point-in-time recovery, which is what a backup actually has to be: the
  # restore drill in `docs/runbooks/restore.md` uses it.
  backup_retention_period   = var.database.backup_retention_days
  backup_window             = "19:30-20:30" # 01:00 IST, the quietest hour
  copy_tags_to_snapshot     = true
  delete_automated_backups  = false
  deletion_protection       = var.database.deletion_protection
  final_snapshot_identifier = "${local.name}-final"

  auto_minor_version_upgrade = true
  maintenance_window         = "sun:20:30-sun:21:30"

  performance_insights_enabled          = true
  performance_insights_kms_key_id       = aws_kms_key.database.arn
  performance_insights_retention_period = 7
  enabled_cloudwatch_logs_exports       = ["postgresql", "upgrade"]

  tags = { Name = local.name }
}

# ---------------------------------------------------------------------------
# Redis, which the queues run on
# ---------------------------------------------------------------------------

resource "aws_elasticache_subnet_group" "this" {
  name       = local.name
  subnet_ids = aws_subnet.data[*].id
}

resource "aws_elasticache_replication_group" "this" {
  replication_group_id = local.name
  description          = "${local.name} queues"

  engine         = "redis"
  engine_version = "7.1"
  node_type      = var.cache_node_type
  port           = 6379

  # One replica in production, so a failed node does not lose the jobs that
  # tell patients their record was read under emergency access (SP5).
  num_cache_clusters         = var.environment == "production" ? 2 : 1
  automatic_failover_enabled = var.environment == "production"
  multi_az_enabled           = var.environment == "production"

  subnet_group_name  = aws_elasticache_subnet_group.this.name
  security_group_ids = [aws_security_group.cache.id]

  at_rest_encryption_enabled = true
  transit_encryption_enabled = true

  snapshot_retention_limit = 3
  apply_immediately        = false

  tags = { Name = local.name }
}

# ---------------------------------------------------------------------------
# Documents
# ---------------------------------------------------------------------------

resource "aws_kms_key" "documents" {
  description             = "${local.name} document storage"
  enable_key_rotation     = true
  deletion_window_in_days = 30
}

resource "aws_kms_alias" "documents" {
  name          = "alias/${local.name}-documents"
  target_key_id = aws_kms_key.documents.key_id
}

resource "aws_s3_bucket" "documents" {
  bucket = "${local.name}-documents"

  tags = { Name = "${local.name}-documents" }
}

resource "aws_s3_bucket_public_access_block" "documents" {
  bucket = aws_s3_bucket.documents.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_versioning" "documents" {
  bucket = aws_s3_bucket.documents.id

  # A scanned report that somebody overwrites is still recoverable, and an
  # object deleted by mistake leaves a delete marker rather than a hole.
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "documents" {
  bucket = aws_s3_bucket.documents.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm     = "aws:kms"
      kms_master_key_id = aws_kms_key.documents.arn
    }
    bucket_key_enabled = true
  }
}

resource "aws_s3_bucket_policy" "documents" {
  bucket = aws_s3_bucket.documents.id
  policy = data.aws_iam_policy_document.documents_bucket.json
}

data "aws_iam_policy_document" "documents_bucket" {
  statement {
    sid    = "DenyUnencryptedTransport"
    effect = "Deny"

    principals {
      type        = "*"
      identifiers = ["*"]
    }

    actions   = ["s3:*"]
    resources = [aws_s3_bucket.documents.arn, "${aws_s3_bucket.documents.arn}/*"]

    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }
}

resource "aws_s3_bucket_cors_configuration" "documents" {
  bucket = aws_s3_bucket.documents.id

  # The clinical app uploads straight to storage with a presigned URL (SP4), so
  # the browser's own origin has to be allowed — and only it.
  cors_rule {
    allowed_methods = ["PUT", "GET"]
    allowed_origins = compact([
      var.domain.clinical != "" ? "https://${var.domain.clinical}" : "",
      var.domain.portal != "" ? "https://${var.domain.portal}" : "",
    ])
    allowed_headers = ["content-type", "content-length"]
    expose_headers  = ["etag"]
    max_age_seconds = 600
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "documents" {
  bucket = aws_s3_bucket.documents.id

  # Old versions are kept for a quarter and then dropped: long enough to undo a
  # mistake, short enough that an erasure request (SP5) does not leave copies
  # behind for years.
  rule {
    id     = "expire-old-versions"
    status = "Enabled"

    filter {}

    noncurrent_version_expiration {
      noncurrent_days = 90
    }

    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }
}
