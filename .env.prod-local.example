# The secrets the production-like local stack needs (sp7-plan.md, T15).
#
#   cp .env.prod-local.example .env.prod-local
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# and paste the output into the two keys below. They are generated rather than
# chosen because the schema refuses a development placeholder when NODE_ENV is
# production (docs/configuration.md), which is the whole point of running this
# stack: the same refusals a deployment has.
#
# This file is git-ignored. Nothing in it is a real credential — the stack it
# configures holds synthetic data only (DF1).

JWT_ACCESS_SECRET=
TOTP_ENCRYPTION_KEY=

# The database passwords the compose file uses. Any value will do locally; the
# point is that they are not defaults baked into an image.
POSTGRES_PASSWORD=health24_prod_local
APP_DB_PASSWORD=health24_prod_local_app

# Storage credentials for the local S3-compatible server. In a deployment there
# are none: the task's IAM role supplies them, and production refuses to start
# if these are set (T2).
STORAGE_ACCESS_KEY_ID=health24_local
STORAGE_SECRET_ACCESS_KEY=health24_local_storage_secret

# Patients cannot be sent a code from this stack, and production refuses the
# `log` provider — so the portal's sign-in is not exercised here. The browser
# suite covers it against the development stack (sp5-plan.md, T23).
