# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000

# Two connections, deliberately.
#
# DATABASE_URL is the application's. It connects as an unprivileged role so
# that row-level security binds to it — superusers and table owners bypass RLS
# entirely, which would make tenant isolation decorative.
#
# DATABASE_ADMIN_URL is the owner's, used only by migrations, seeding and the
# local bootstrap. The running API never uses it.
DATABASE_URL=postgresql://health24_api:health24_local_dev@localhost:5433/health24
DATABASE_ADMIN_URL=postgresql://health24:health24_local_dev@localhost:5433/health24

# Redis
REDIS_URL=redis://localhost:6380

# Auth — generate real secrets for any non-local environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_only_replace_me_access
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts TOTP secrets at rest. 32 bytes, base64url:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOTP_ENCRYPTION_KEY=dev_only_replace_me_totp_key_32b_aaaaaaaa

# TOTP
TOTP_ISSUER=Health24

# Logging
LOG_LEVEL=debug

# Document storage (SP4). Locally, the S3-compatible server in Docker Compose;
# in production, AWS S3 in ap-south-1 with no endpoint or keys set here.
STORAGE_ENDPOINT=http://localhost:7070
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=health24-documents
STORAGE_ACCESS_KEY_ID=health24_local
STORAGE_SECRET_ACCESS_KEY=health24_local_storage_secret

# Upload scanning (SP4): clamd in Docker Compose
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
