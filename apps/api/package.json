{
  "name": "@health24/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:bootstrap": "tsx src/db/bootstrap-local.ts",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:tenancy": "node scripts/smoke-tenancy.mjs",
    "smoke:patients": "node scripts/smoke-patients.mjs",
    "db:wait": "tsx src/db/wait-for-db.ts",
    "db:clean": "tsx src/db/clean-dev-data.ts",
    "terminology:import": "tsx src/modules/terminology/cli/import.ts",
    "terminology:load-demo": "tsx src/modules/terminology/cli/import.ts data/terminology/demo/demo-namaste.json data/terminology/demo/demo-icd11-tm2.json data/terminology/demo/demo-icd11-mms.json data/terminology/demo/map-namaste-icd11-tm2.json data/terminology/demo/map-namaste-icd11-mms.json --activate --by demo-loader",
    "smoke:terminology": "node scripts/smoke-terminology.mjs",
    "mfa:code": "node scripts/mfa-code.mjs",
    "worker": "nest start --watch --entryFile worker",
    "worker:start": "node dist/worker.js",
    "storage:bootstrap": "tsx src/modules/storage/cli/bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@health24/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.3.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.2.0",
    "otpauth": "^9.3.6",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.1",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.6.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
